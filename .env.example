# Platypus environment variables
# Copy this file to `.env` and fill in the keys you want to enable.
# Every *_BASE_URL is optional (root path only); unset falls back to the official endpoint.
# Any provider without its key configured is silently skipped.

# --- Search provider keys ---
TAVILY_API_KEY=
# Tavily base URL root only (e.g. https://api.tavily.com)
TAVILY_BASE_URL=
EXA_API_KEY=
# Exa base URL root only (e.g. https://api.exa.ai)
EXA_BASE_URL=
BRAVE_API_KEY=
# Brave base URL root only (e.g. https://api.search.brave.com)
BRAVE_BASE_URL=
JINA_API_KEY=
# Jina base URL root only (e.g. https://s.jina.ai)
JINA_BASE_URL=
FIRECRAWL_API_KEY=
# Firecrawl base URL root only (e.g. https://api.firecrawl.dev)
FIRECRAWL_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
OLLAMA_API_KEY=
# Ollama base URL root only (e.g. https://ollama.com)
OLLAMA_BASE_URL=

# --- SearXNG (self-hosted, no API key) ---
# e.g. http://localhost:8080
SEARXNG_BASE_URL=

# --- AI aggregation / cleanup (used by mode=AIAggregation) ---
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FORMAT=
AI_TIMEOUT_MS=10000

# --- Aggregation strategy ---
# Provider weights for search post-processing, format provider:value, comma separated
# e.g. exa:1.5,gemini:0.7
SEARCH_PROVIDER_WEIGHTS=
# Domain blacklist source URL (optional; built-in default used when unset)
DOMAIN_BLACKLIST_URL=
