# 使用 platypus --env /path/to/.env 显式指定本文件。未指定时仅使用系统环境变量。
# 指定文件中的变量优先；缺少的变量从系统环境变量读取。
PLATYPUS_EXA_API_KEY=
PLATYPUS_EXA_BASE_URL=
PLATYPUS_TAVILY_API_KEY=
PLATYPUS_TAVILY_BASE_URL=
PLATYPUS_JINA_API_KEY=
PLATYPUS_JINA_BASE_URL=
PLATYPUS_BRAVE_API_KEY=
PLATYPUS_BRAVE_BASE_URL=
PLATYPUS_GEMINI_API_KEY=
# Gemini 搜索模型，可由 --model 覆盖；两者都不指定时默认 gemini-flash-lite-latest。
PLATYPUS_GEMINI_MODEL=
PLATYPUS_GEMINI_BASE_URL=
PLATYPUS_OLLAMA_API_KEY=
PLATYPUS_OLLAMA_BASE_URL=
# 自托管 SearXNG 实例需启用 JSON 格式。
PLATYPUS_SEARXNG_BASE_URL=

# 使用 --ai 时必填。BASE_URL 可选；OpenAI 地址末段路径替换为 /v1，Anthropic 原样使用。
# 可选 openai、anthropic、gemini。
PLATYPUS_AI_FORMAT=openai
PLATYPUS_AI_API_KEY=
PLATYPUS_AI_MODEL=
PLATYPUS_AI_BASE_URL=
# 单次 AI 清洗调用 (含 SDK 重试) 的最长时间, 单位秒; 未指定时默认 120 秒。
PLATYPUS_AI_TIMEOUT=120
# 仅设为 true 时使用 OpenAI / Anthropic SDK 的流式完整响应聚合；Gemini AI 始终非流式。
PLATYPUS_AI_STREAMBLE=false
# Anthropic 请求必须指定输出 token 上限，默认 8192；请按模型支持范围调整。
PLATYPUS_AI_MAX_TOKENS=8192
